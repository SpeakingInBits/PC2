@model ResourceLinksModel

@{
	ViewData["Title"] = "Delete Resource Link";
}

@* 
DeleteResourceLink.cshtml - Two-step delete confirmation page
Displays resource details before permanent deletion
User can confirm delete or cancel to return to management page
POST to Resources/Delete removes the resource from database
*@

<section class="content-header">
	<h1>@ViewData["Title"]</h1>
	<div class="divider"></div>
</section>

<div class="row">
	<div class="col-md-8">
		<div class="alert alert-warning">
			<strong>Warning:</strong> Are you sure you want to delete this resource link? This action cannot be undone.
		</div>

		<div class="card">
			<div class="card-body">
				<dl class="row">
					<dt class="col-sm-3">Link Text</dt>
					<dd class="col-sm-9">@Model.LinkText</dd>

					<dt class="col-sm-3">Link URL</dt>
					<dd class="col-sm-9">
						<a href="@Model.LinkURL" target="_blank" rel="noopener noreferrer">
							@Model.LinkURL
						</a>
					</dd>

					@if (!string.IsNullOrEmpty(Model.Description))
					{
						<dt class="col-sm-3">Description</dt>
						<dd class="col-sm-9">@Model.Description</dd>
					}
				</dl>
			</div>
		</div>

		<form asp-action="Delete" asp-controller="Resources" method="post" class="mt-3">
			<input asp-for="ResourceID" type="hidden" />

			<button type="submit" class="btn btn-danger">
				<i class="fas fa-trash"></i> Delete
			</button>
			<a href="@Url.Action("ManageResourceLinks", "Resources")" class="btn btn-secondary">
				<i class="fas fa-times"></i> Cancel
			</a>
		</form>
	</div>
</div>
