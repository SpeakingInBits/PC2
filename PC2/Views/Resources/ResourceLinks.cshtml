@model List<ResourceLink>

@section head {

}

@{
    ViewData["Title"] = "Resource Links";
}

<div class="d-flex justify-content-center">
    <img src="~/images/resource-links/links1.jpg" alt="" />
    <img src="~/images/resource-links/links2.jpg" alt="" />
    <img src="~/images/resource-links/links3.jpg" alt="" />
    <img src="~/images/resource-links/links4.jpg" alt="" />
</div>
<br />
<h1>@ViewData["Title"]</h1>

<div class="divider"></div>

<p class="text-center">Please click on the links below to access the Internet resource listed:</p>
<br />
<div class="row justify-content-center">
    @* Split the alphabetical list into two columns *@
    @foreach (IEnumerable<ResourceLink> column in Model.Chunk(Math.Max(1, (Model.Count + 1) / 2)))
    {
        <div class="col-12 col-md-4">
            <ul>
                @foreach (ResourceLink link in column)
                {
                    <li>
                        <a href="@link.Url" target="@(link.Url.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) ? "_blank" : null)">@link.Name</a>
                        @if (!string.IsNullOrEmpty(link.Description))
                        {
                            <p>@link.Description</p>
                        }
                    </li>
                }
            </ul>
        </div>
    }
</div>
<p class="text-center">Did we miss a resource you know about?  Let us know at <a href="mailto:info@pc2online.org">info@pc2online.org</a></p>