@model List<ResourceLinksModel>    

@{
    ViewData["Title"] = "Resource Links";

    // Only compute grouping if model exists and has items
    var groupedByLetter = (Model != null && Model.Count > 0)
        ? Model.GroupBy(r => r.LinkText.ElementAt(0).ToString())
               .OrderBy(g => g.Key)
        : null;
}

<head>
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<div class="d-flex justify-content-center">
    <img src="~/images/resource-links/links1.jpg" />
    <img src="~/images/resource-links/links2.jpg" />
    <img src="~/images/resource-links/links3.jpg" />
    <img src="~/images/resource-links/links4.jpg" />
</div>
<br />
<h1>@ViewData["Title"]</h1>

<div class="divider"></div>

@if (User.IsInRole("Admin") || User.IsInRole("Staff"))
{
    <div class="mb-3">
        <a href="@Url.Action("ManageResourceLinks", "Resources")" class="btn btn-primary btn-sm">
            <i class="fas fa-cog"></i> Manage Resource Links
        </a>
    </div>
}

<p class="text-center">Please click on the links below to access the Internet resource listed:</p>
<br />

@if (groupedByLetter != null)
{
    <div class="container">
        <ul style="list-style: none; padding: 0;">
            @foreach (var letterGroup in groupedByLetter)
            {
                <li style="margin-top: 20px; margin-bottom: 10px;">
                    <h5 style="border-bottom: 2px solid #333; padding-bottom: 5px;">@letterGroup.Key</h5>
                </li>

                @foreach (var resource in letterGroup.OrderBy(r => r.LinkText))
                {
                    <li style="margin-left: 20px; margin-bottom: 15px;">
                        <a href="@resource.LinkURL" target="_blank" rel="noopener noreferrer">@resource.LinkText</a>
                        @if (!string.IsNullOrEmpty(resource.Description))
                        {
                            <p style="margin-top: 5px; margin-bottom: 0; font-size: 0.95em; color: #666;">@resource.Description</p>
                        }
                    </li>
                }
            }
        </ul>
    </div>
}
else
{
    <div class="alert alert-info text-center">
        No resource links are currently available.
    </div>
}


<p class="text-center">Did we miss a resource you know about? Let us know at <a href="mailto:info@pc2online.org">info@pc2online.org</a></p>
