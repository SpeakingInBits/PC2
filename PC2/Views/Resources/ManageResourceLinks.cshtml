@model List<ResourceLinksModel>

@{
	ViewData["Title"] = "Manage Resource Links";
}

@*
ManageResourceLinks.cshtml - Admin management dashboard for resource links
Displays all resources in alphabetical order with Edit/Delete actions
Add New Resource Link button opens Create form
*@

<section class="content-header">
	<h1>@ViewData["Title"]</h1>
	<div class="divider"></div>
</section>

<div class="row mb-3">
	<div class="col-md-12">
		<a href="@Url.Action("Create", "Resources")" class="btn btn-primary btn-style-match">
			<i class="fas fa-plus"></i> Add New Resource Link
		</a>
	</div>
</div>

@if (Model?.Count > 0)
{
	<div class="table-responsive">
		<table class="table table-striped table-hover">
			<thead class="table-style-match">
				<tr>
					<th>Link Text</th>
					<th>URL</th>
					<th class="limit-description-width">Description</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var resource in Model.OrderBy(r => r.LinkText))
				{
					<tr class="vertical-align">
						<td>@resource.LinkText</td>
						<td>
							<a href="@resource.LinkURL" target="_blank" rel="noopener noreferrer">
								@(resource.LinkURL.Length > 50 ? resource.LinkURL.Substring(0, 50) + "..." : resource.LinkURL)
							</a>
						</td>
						<td>
							@if (!string.IsNullOrEmpty(resource.Description))
							{
								@(resource.Description.Length > 100 ? resource.Description.Substring(0, 100) + "..." : resource.Description)
							}
						</td>
						<td class="uniform-row">
							<a href="@Url.Action("Edit", "Resources", new { id = resource.ResourceID })" class="btn btn-sm btn-warning btn-style-match">
								<i class="fas fa-edit"></i> Edit
							</a>
							<a href="@Url.Action("Delete", "Resources", new { id = resource.ResourceID })" class="btn btn-sm btn-danger btn-style-match">
								<i class="fas fa-trash"></i> Delete
							</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}
else
{
	<div class="alert alert-info">
		<strong>No resource links found.</strong> <a href="@Url.Action("Create", "Resources")">Add the first one</a>.
	</div>
}
