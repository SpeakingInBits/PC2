@model List<JobOpportunityViewModel>

@{
    ViewData["Title"] = "Job Opportunities";
}

<h1>@ViewData["Title"]</h1>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        There are no job openings at this time. Please check back later!
    </div>
}
else
{
    @foreach (var jobViewModel in Model)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h2 class="card-title h3 fw-bold">@jobViewModel.Job.Title</h2>
                @if (jobViewModel.Job.ClosingDate != null)
                {
                    <p class="card-subtitle h6 fw-bold mb-2 text-muted">Applications close @jobViewModel.Job.ClosingDate.Value.ToString("MMMM d, yyyy")</p>
                }
                <p class="card-text" style="white-space: pre-line">@Html.Raw(jobViewModel.SanitizedDescription)</p>
                @if (!string.IsNullOrEmpty(jobViewModel.Job.AttachmentLocation))
                {
                    <a href="@jobViewModel.Job.AttachmentLocation" target="_blank" class="card-link">
                        <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> @jobViewModel.Job.AttachmentName<span class="visually-hidden"> (PDF)</span>
                    </a>
                }
            </div>
        </div>
    }
}
