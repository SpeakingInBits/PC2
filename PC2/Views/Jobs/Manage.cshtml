@model IEnumerable<PC2.Models.JobOpportunity>

@{
    ViewData["Title"] = "Manage Job Opportunities";
}

<h1>@ViewData["Title"]</h1>

@{
    if (TempData["Message"] is string message)
    {
        bool isError = message.StartsWith("Error");
        <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="@(isError ? "alert" : "status")">
            @message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
}

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Job</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th scope="col">Title</th>
            <th scope="col">Closing Date</th>
            <th scope="col">Attachment</th>
            <th scope="col">Status</th>
            <th scope="col"><span class="visually-hidden">Actions</span></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var job in Model)
        {
            <tr>
                <td>@job.Title</td>
                <td>
                    @if (job.ClosingDate != null)
                    {
                        @job.ClosingDate.Value.ToString("MMMM d, yyyy")
                    }
                    else
                    {
                        <span class="text-muted">None</span>
                    }
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(job.AttachmentLocation))
                    {
                        <a href="@job.AttachmentLocation" target="_blank">@job.AttachmentName</a>
                    }
                    else
                    {
                        <span class="text-muted">None</span>
                    }
                </td>
                <td>
                    @if (job.IsOpen)
                    {
                        <span class="badge bg-success">Open</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary text-dark">Closed</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@job.JobOpportunityId" class="btn btn-sm btn-outline-primary">Edit<span class="visually-hidden"> @job.Title</span></a>
                    <a asp-action="Delete" asp-route-id="@job.JobOpportunityId" class="btn btn-sm btn-outline-danger">Delete<span class="visually-hidden"> @job.Title</span></a>
                    @if (job.IsOpen)
                    {
                        <form asp-action="Close" asp-route-id="@job.JobOpportunityId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Close<span class="visually-hidden"> @job.Title</span></button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Reopen" asp-route-id="@job.JobOpportunityId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-success">Reopen<span class="visually-hidden"> @job.Title</span></button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
