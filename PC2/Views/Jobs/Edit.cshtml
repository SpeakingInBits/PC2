@model PC2.Models.JobOpportunity

@{
    ViewData["Title"] = "Edit Job Opportunity";
}

<h1>@ViewData["Title"]</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" enctype="multipart/form-data" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="JobOpportunityId" />
            <input type="hidden" asp-for="IsClosed" />
            <input type="hidden" asp-for="AttachmentLocation" />
            <input type="hidden" asp-for="AttachmentName" />

            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control" rows="8"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ClosingDate" class="control-label"></label>
                <input asp-for="ClosingDate" class="form-control" type="date" />
                <span asp-validation-for="ClosingDate" class="text-danger"></span>
                <small class="form-text text-muted">Optional. The job will no longer be shown publicly after this date passes.</small>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Attachment (optional)</label>
                @if (!string.IsNullOrEmpty(Model.AttachmentLocation))
                {
                    <p class="mb-1">
                        Current attachment: <a href="@Model.AttachmentLocation" target="_blank">@Model.AttachmentName</a>
                    </p>
                }
                <input type="file" name="attachmentFile" id="attachmentFile" accept=".pdf" onchange="checkFileSize()" class="form-control" />
                <span id="fileSizeError" class="text-danger"></span>
                <div id="fileSizeWarning" class="alert alert-warning mt-2 mb-0 py-2 d-none" role="alert"></div>
                @if (!string.IsNullOrEmpty(Model.AttachmentLocation))
                {
                    <small class="form-text text-muted">Uploading a new file will replace the current attachment.</small>
                }
            </div>

            <div class="form-group">
                <input id="submitButton" type="submit" value="Save Changes" class="btn btn-primary" />
                <a asp-action="Manage" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/jobs.js"></script>
}
