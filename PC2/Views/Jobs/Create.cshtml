@model PC2.Models.JobOpportunity

@{
    ViewData["Title"] = "Add Job Opportunity";
}

<h1>@ViewData["Title"]</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" enctype="multipart/form-data" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <p class="small"><span class="text-danger" aria-hidden="true">*</span> Required field</p>

            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label"></label><span class="text-danger" aria-hidden="true"> *</span>
                <input asp-for="Title" class="form-control" aria-required="true" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label"></label><span class="text-danger" aria-hidden="true"> *</span>
                <textarea asp-for="Description" class="form-control" rows="8" aria-required="true"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ClosingDate" class="control-label"></label>
                <input asp-for="ClosingDate" class="form-control" type="date" aria-describedby="closingDateHelp" />
                <span asp-validation-for="ClosingDate" class="text-danger"></span>
                <small class="form-text text-muted" id="closingDateHelp">Optional. The job will no longer be shown publicly after this date passes.</small>
            </div>

            <div class="form-group mb-3">
                <label for="attachmentFile" class="control-label">Attachment (optional)</label>
                <input type="file" name="attachmentFile" id="attachmentFile" accept=".pdf" onchange="checkFileSize()" class="form-control" aria-describedby="fileSizeError fileSizeWarning" />
                <span id="fileSizeError" class="text-danger" role="alert"></span>
                <div id="fileSizeWarning" class="alert alert-warning mt-2 mb-0 py-2 d-none" role="alert"></div>
            </div>

            <div class="form-group">
                <input id="submitButton" type="submit" value="Add Job" class="btn btn-primary" />
                <a asp-action="Manage" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/jobs.js"></script>
}
