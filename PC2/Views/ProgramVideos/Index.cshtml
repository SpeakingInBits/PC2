@model IEnumerable<PC2.Models.ProgramVideo>

@section head {
    <partial name="_BootstrapIconsPartial" />
    <style>
        h2 {
            text-align: center;
        }
        /* The video's thumbnail, which is swapped for the YouTube player when it's pressed */
        .video-poster {
            padding: 0;
            border: 0;
            background: #000;
            cursor: pointer;
        }
        .video-poster img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .video-poster:focus-visible {
            outline: 3px solid #000;
            outline-offset: 3px;
        }
        .video-play-icon {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 68px;
            height: 48px;
            transform: translate(-50%, -50%);
            border-radius: 12px;
            background: rgba(33, 37, 41, .85);
        }
        .video-play-icon::after {
            content: "";
            position: absolute;
            top: 50%;
            left: 54%;
            transform: translate(-50%, -50%);
            border-style: solid;
            border-width: 11px 0 11px 19px;
            border-color: transparent transparent transparent #fff;
        }
        .video-poster:hover .video-play-icon, .video-poster:focus-visible .video-play-icon {
            background: #c00;
        }
        .video-section {
            margin-bottom: 2rem;
        }
        /* Keeps the look of the page's previous <h1> video titles */
        .video-title {
            font-size: 1.5em;
            margin-bottom: .5rem;
        }
        .player-frame {
            max-width: 640px;
        }
    </style>
}

@{
    ViewData["Title"] = "Program Videos";
}
<div class="d-flex justify-content-center">
    <img src="~/images/program-videos/Filmstrip.webp" alt="Horizontal black and white filmstrip representing PC2's legal video series" width="977" height="279" />
</div>

<div>
    <h1>PC2 Legal Series</h1>
</div>

<div class="divider"></div>

@if (Model != null && Model.Any())
{
    <div id="video-list">
        @foreach (var video in Model)
        {
            <div class="video-section">
                <div class="flex-column justify-content-center">
                    <h2 class="video-title">@video.Title</h2>
                </div>
                @* The ratio wrapper lets the player shrink to fit small screens. The YouTube player is only
                   loaded when the thumbnail is pressed, so the page doesn't load a player for every video. *@
                <div class="player-frame ratio ratio-16x9 mx-auto">
                    <button type="button" class="video-poster" data-youtube-id="@video.YouTubeVideoId" data-title="@video.Title"
                            aria-label="Play video: @video.Title">
                        <img src="https://i.ytimg.com/vi/@video.YouTubeVideoId/hqdefault.jpg" alt="" loading="lazy" />
                        <span class="video-play-icon" aria-hidden="true"></span>
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(video.PdfLocation))
                {
                    <div class="row g-4 mt-1">
                        <div class="col-12 col-lg-8">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body d-flex flex-column">
                                    <div class="d-flex align-items-center mb-3 min-width-0">
                                        <i class="bi bi-file-earmark-pdf text-danger me-3 fs-1" aria-hidden="true"></i>
                                        <div class="flex-grow-1">
                                            <h3 class="card-title h5 fw-bold mb-1 text-primary">@video.PdfName</h3>
                                            <small class="text-muted">PDF Handout</small>
                                        </div>
                                    </div>
                                    <div class="mt-auto">
                                        <a href="@video.PdfLocation"
                                           target="_blank"
                                           class="btn btn-primary text-white w-100 d-flex align-items-center justify-content-center"
                                           aria-label="Download PDF: @video.PdfName">
                                            <i class="bi bi-download me-2" aria-hidden="true"></i>
                                            Download PDF
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                <br />
            </div>
        }
    </div>

    <script>
        // Swaps a video's thumbnail for the YouTube player, which starts playing straight away
        document.querySelectorAll('.video-poster').forEach(function (poster) {
            poster.addEventListener('click', function () {
                var player = document.createElement('iframe');
                player.src = 'https://www.youtube.com/embed/' + encodeURIComponent(poster.dataset.youtubeId) + '?autoplay=1&playsinline=1';
                // Size comes from the .ratio wrapper so the player fits narrow screens
                player.title = poster.dataset.title;
                player.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
                player.allowFullscreen = true;
                player.referrerPolicy = 'strict-origin-when-cross-origin';
                poster.replaceWith(player);
                // Keyboard and screen reader users carry on from the player
                player.focus();
            });
        });
    </script>
}
else
{
    <p>No videos are currently available.</p>
}
