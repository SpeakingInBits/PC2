@model IEnumerable<PC2.Models.ProgramVideo>

@{
    ViewData["Title"] = "Manage Program Videos";
}

<h1>@ViewData["Title"]</h1>

@{
    if (TempData["Message"] is string message)
    {
        bool isError = message.StartsWith("Error");
        <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="@(isError ? "alert" : "status")">
            @message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
}

<p>
    <a asp-action="CreateVideo" class="btn btn-primary">Add New Video</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th scope="col">Title</th>
            <th scope="col">YouTube Video ID</th>
            <th scope="col">PDF Attachment</th>
            <th scope="col"><span class="visually-hidden">Actions</span></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var video in Model)
        {
            <tr>
                <td>@video.Title</td>
                <td>@video.YouTubeVideoId</td>
                <td>
                    @if (!string.IsNullOrEmpty(video.PdfLocation))
                    {
                        <a href="@video.PdfLocation" target="_blank">@video.PdfName</a>
                    }
                    else
                    {
                        <span class="text-muted">None</span>
                    }
                </td>
                <td>
                    <a asp-action="EditVideo" asp-route-id="@video.ProgramVideoId">Edit<span class="visually-hidden"> @video.Title</span></a> |
                    <a asp-action="DeleteVideo" asp-route-id="@video.ProgramVideoId">Delete<span class="visually-hidden"> @video.Title</span></a>
                </td>
            </tr>
        }
    </tbody>
</table>
