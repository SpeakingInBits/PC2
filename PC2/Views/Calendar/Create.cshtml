@model CalendarCreateEventViewModel
@{
    ViewData["Title"] = "Create Event";
}

<div class="justify-content-center">
    <h1>@ViewData["Title"]</h1>
</div>

<div class="row justify-content-center">
    <div class="col-md-4">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <p class="small"><span class="text-danger" aria-hidden="true">*</span> Required field</p>
        <form id="create" class="form" asp-action="Create" method="post">
            <div class="form-group">
                <label asp-for="DateOfEvent" class="control-label">Set date for event</label><span class="text-danger" aria-hidden="true"> *</span>
                <input asp-for="DateOfEvent" class="form-control" type="date" aria-required="true" />
                <span asp-validation-for="DateOfEvent" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StartingTime" class="control-label">Set a starting time</label><span class="text-danger" aria-hidden="true"> *</span>
                <input asp-for="StartingTime" class="form-control" type="time" aria-required="true" />
                <span asp-validation-for="StartingTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EndingTime" class="control-label">Set an ending time</label><span class="text-danger" aria-hidden="true"> *</span>
                <input asp-for="EndingTime" class="form-control" type="time" aria-required="true" />
                <span asp-validation-for="EndingTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label">Describe the event</label><span class="text-danger" aria-hidden="true"> *</span>
                <textarea asp-for="Description" class="form-control" rows="5" aria-required="true"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <fieldset class="form-group" aria-describedby="event-type-error">
                <legend class="fs-6 mb-0">Event type (choose one)<span class="text-danger" aria-hidden="true"> *</span></legend>
                <div class="checkbox">
                    <input asp-for="IsPc2Event" type="checkbox"/>
                    <label asp-for="IsPc2Event">PC2 Event</label>
                    <input asp-for="IsCountyEvent" type="checkbox" />
                    <label asp-for="IsCountyEvent">County Event</label>
                </div>
                <span asp-validation-for="IsCountyEvent" class="text-danger" id="event-type-error"></span>
            </fieldset>
            <div class="form-group">
                <input id="submit" type="submit" value="Create Event" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
