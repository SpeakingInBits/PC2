@model CalendarCreateEventViewModel

@{
    ViewData["Title"] = "Edit Event";
}

<h1>@ViewData["Title"]</h1>

<h2 class="h4">Calendar Event</h2>
<hr />
@if (Model.SeriesId.HasValue)
{
    <div class="alert alert-info" role="note">
        <p class="mb-1">
            This date is part of a repeating event: <strong>@Model.SeriesSchedule</strong>.
            Changes here only affect this date.
        </p>
        <a asp-action="EditSeries" asp-route-id="@Model.SeriesId">Edit every date in the series instead</a>
    </div>
}
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <p class="small"><span class="text-danger" aria-hidden="true">*</span> Required field</p>
            <input type="hidden" asp-for="EventId" />
            <div class="form-group">
                <label asp-for="DateOfEvent" class="control-label"></label><span class="text-danger" aria-hidden="true"> *</span>
                <input asp-for="DateOfEvent" class="form-control" type="date" aria-required="true" />
                <span asp-validation-for="DateOfEvent" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StartingTime" class="control-label"></label><span class="text-danger" aria-hidden="true"> *</span>
                <input asp-for="StartingTime" class="form-control" type="time" aria-required="true" />
                <span asp-validation-for="StartingTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EndingTime" class="control-label"></label><span class="text-danger" aria-hidden="true"> *</span>
                <input asp-for="EndingTime" class="form-control" type="time" aria-required="true" />
                <span asp-validation-for="EndingTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label><span class="text-danger" aria-hidden="true"> *</span>
                <textarea asp-for="Description" class="form-control" rows="5" aria-required="true"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <fieldset aria-describedby="event-type-error">
                <legend class="fs-6 mb-0">Event type (choose one)<span class="text-danger" aria-hidden="true"> *</span></legend>
                <div class="form-group form-check">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="IsPc2Event" /> @Html.DisplayNameFor(model => model.IsPc2Event)
                    </label>
                </div>
                <div class="form-group form-check">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="IsCountyEvent" /> @Html.DisplayNameFor(model => model.IsCountyEvent)
                    </label>
                    <br>
                    <span asp-validation-for="IsCountyEvent" class="text-danger" id="event-type-error"></span>
                </div>
            </fieldset>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">Back to calendar</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
