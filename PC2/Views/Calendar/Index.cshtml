@model List<CalendarEventViewModel>
@{
    ViewData["Title"] = "Event Calendar";

    // Events for FullCalendar. The plain description is the title shown on the calendar;
    // the linkified description is shown in the event panel
    var calendarEvents = Model.Select(vm => new
    {
        id = vm.Event.CalendarEventID.ToString(),
        title = vm.Event.EventDescription,
        start = vm.Event.StartingDateTime.ToString("yyyy-MM-ddTHH:mm:ss"),
        end = vm.Event.EndingDateTime.ToString("yyyy-MM-ddTHH:mm:ss"),
        classNames = new[] { vm.Event.PC2Event ? "pc2-event" : "county-event" },
        extendedProps = new
        {
            descriptionHtml = vm.SanitizedDescription,
            isPc2Event = vm.Event.PC2Event,
            seriesId = vm.Event.EventSeriesID,
            seriesSchedule = vm.SeriesSchedule,
            dateLabel = vm.Event.DateOfEvent.ToString("dddd, MMMM d, yyyy"),
            timeLabel = $"{vm.Event.StartingTime:h:mm tt} - {vm.Event.EndingTime:h:mm tt}"
        }
    });
}

<h1>@ViewData["Title"]</h1>

@if (TempData["UpdateFailed"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["UpdateFailed"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">
        </button>
    </div>
}

@if (TempData["CalendarMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="status">
        @TempData["CalendarMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">
        </button>
    </div>
}

@if (TempData["EventDeleted"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="status">
        Event was deleted successfully!
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">
        </button>
    </div>
}

<div class="d-flex flex-wrap align-items-center gap-3 mb-2">
    <a asp-action="Create" class="btn btn-primary">Create Event</a>
    <fieldset class="d-flex flex-wrap align-items-center gap-3">
        <legend class="visually-hidden">Show events</legend>
        <div class="form-check mb-0">
            <input class="form-check-input" type="checkbox" id="show-pc2-events" checked data-calendar-filter="pc2" />
            <label class="form-check-label" for="show-pc2-events">
                <span class="calendar-swatch pc2-event" aria-hidden="true"></span> PC2 events
            </label>
        </div>
        <div class="form-check mb-0">
            <input class="form-check-input" type="checkbox" id="show-county-events" checked data-calendar-filter="county" />
            <label class="form-check-label" for="show-county-events">
                <span class="calendar-swatch county-event" aria-hidden="true"></span> County events
            </label>
        </div>
    </fieldset>
</div>
<p class="small text-muted">
    Choose a day's <strong>+</strong> button to add an event on that date. Choose an event to edit, duplicate, or delete it.
    <i class="bi bi-arrow-repeat" aria-hidden="true"></i> marks repeating events.
</p>

<div id="admin-calendar" class="admin-calendar"
     data-create-url="@Url.Action("Create", "Calendar")"
     data-edit-url="@Url.Action("Edit", "Calendar")"
     data-edit-series-url="@Url.Action("EditSeries", "Calendar")"
     data-delete-series-url="@Url.Action("DeleteSeries", "Calendar")"></div>

<script type="application/json" id="calendar-events">@Json.Serialize(calendarEvents)</script>

<form id="delete-event-form" asp-action="Delete" method="post" hidden>
    <input type="hidden" name="id" />
</form>

<div class="modal fade" id="event-actions" tabindex="-1" aria-labelledby="event-actions-title" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5 fw-bold" id="event-actions-title">Event</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1">
                    <strong data-event-date></strong><br />
                    <span data-event-time></span> &middot; <span data-event-type></span>
                </p>
                <div class="event-actions-description mb-2" data-event-description></div>
                <p class="small text-muted mb-3" data-event-series>
                    <i class="bi bi-arrow-repeat" aria-hidden="true"></i> Repeats: <span data-event-schedule></span>
                </p>

                <div data-single-actions>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-primary btn-sm" data-action="edit">Edit</a>
                        <a class="btn btn-outline-secondary btn-sm" data-action="duplicate">Duplicate</a>
                        <button type="button" class="btn btn-outline-danger btn-sm" data-action="delete">Delete</button>
                    </div>
                </div>

                <div data-series-actions>
                    <h3 class="h6 mb-1">This date only</h3>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <a class="btn btn-primary btn-sm" data-action="edit">Edit this date</a>
                        <button type="button" class="btn btn-outline-danger btn-sm" data-action="delete">Delete this date</button>
                    </div>
                    <h3 class="h6 mb-1">Every date in the series</h3>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-primary btn-sm" data-action="edit-series">Edit series</a>
                        <a class="btn btn-outline-danger btn-sm" data-action="delete-series">Delete series</a>
                        <a class="btn btn-outline-secondary btn-sm" data-action="duplicate">Duplicate as new event</a>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"
            integrity="sha384-B1OFx8Gy9GjPu8UbUyXbGQpzll9ubAUQ9agInFJ8NnD7nYG1u/CLR+Sqr5yifl4q"
            crossorigin="anonymous"></script>
    <script src="~/js/admin-calendar.js" asp-append-version="true"></script>
}
