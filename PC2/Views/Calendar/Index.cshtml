@model List<CalendarEventViewModel>
@{
    ViewData["Title"] = "Event Calendar";

    List<List<CalendarEventViewModel>> eventDateGroups =
            Model
            .GroupBy(vm => vm.Event.DateOfEvent)
            .Select(group => group.ToList())
            .ToList();
}

@section Head{
	<style>
		.agenda .agenda-date {
			width: 170px;
		}

		.agenda .agenda-date .dayofmonth {
			width: 40px !important;
			font-size: 36px !important;
			line-height: 36px !important;
			float: left;
			text-align: right;
			margin-right: 10px;
		}

		.agenda .agenda-date .shortdate {
			font-size: 0.75em;
		}


		/* Times */
		.agenda .agenda-time {
			width: 140px;
		}
	</style>
}


<h1>@ViewData["Title"]</h1>

@if (TempData["UpdateFailed"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["UpdateFailed"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">
        </button>
    </div>
}

@if (TempData["CalendarMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="status">
        @TempData["CalendarMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">
        </button>
    </div>
}

@if (TempData["EventDeleted"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="status">
        Event was deleted successfully!
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">
        </button>
    </div>
}

<div class="agenda">
    <div class="table-responsive">
        <table class="table table-condensed table-bordered">
            <thead>
                <tr>
                    <th scope="col">Date</th>
                    <th scope="col">Time</th>
                    <th scope="col">Event</th>
                    <th scope="col">Type</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @for (int currentDate = 0; currentDate < eventDateGroups.Count; currentDate++)
                {
                    List<CalendarEventViewModel> dateGroup = eventDateGroups[currentDate];

                    @*loop through all events on this date; the date cell spans every event row for that date*@
                    @for (int currentEvent = 0; currentEvent < dateGroup.Count; currentEvent++)
                    {
                        CalendarEvent calendarEvent = dateGroup[currentEvent].Event;
                        string eventContext = calendarEvent.DateOfEvent.ToString("MMMM d, yyyy") + " at " + calendarEvent.StartingTime;
                        <tr>
                            @if (currentEvent == 0)
                            {
                                <td class="agenda-date" rowspan="@dateGroup.Count">
                                    <div class="dayofmonth">@calendarEvent.DateOfEvent.Day</div>
                                    <div class="dayofweek">@calendarEvent.DateOfEvent.DayOfWeek</div>
                                    <div class="shortdate text-muted">@calendarEvent.DateOfEvent.ToString("MMMM"),&nbsp;@calendarEvent.DateOfEvent.Year</div>
                                </td>
                            }
                            <td class="agenda-time">
                                @calendarEvent.StartingTime &nbsp;-&nbsp; @calendarEvent.EndingTime
                            </td>
                            <td class="agenda-events">
                                <div class="agenda-event">
                                    @Html.Raw(dateGroup[currentEvent].SanitizedDescription)
                                </div>
                                @if (dateGroup[currentEvent].SeriesSchedule != null)
                                {
                                    <div class="small text-muted">
                                        <span aria-hidden="true">&#x21bb;</span> Repeats: @dateGroup[currentEvent].SeriesSchedule
                                    </div>
                                }
                            </td>
                            <td>
                                @if (calendarEvent.PC2Event)
                                {
                                    <p>
                                        PC2 Event
                                    </p>
                                }
                                else
                                {
                                    <p>
                                        County Event
                                    </p>
                                }
                            </td>
                            <td>
                                @if (calendarEvent.EventSeriesID.HasValue)
                                {
                                    <p class="mb-1">
                                        <a asp-action="Edit" asp-route-id="@calendarEvent.CalendarEventID">Edit this date<span class="visually-hidden"> of event on @eventContext</span></a> |
                                        <a asp-action="Delete" onclick="confirmEventDeletion('Delete only this date of the repeating event?');" asp-route-id="@calendarEvent.CalendarEventID">Delete this date<span class="visually-hidden"> of event on @eventContext</span></a>
                                    </p>
                                    <p>
                                        <a asp-action="EditSeries" asp-route-id="@calendarEvent.EventSeriesID">Edit series<span class="visually-hidden"> for event on @eventContext</span></a> |
                                        <a asp-action="DeleteSeries" asp-route-id="@calendarEvent.EventSeriesID">Delete series<span class="visually-hidden"> for event on @eventContext</span></a>
                                    </p>
                                }
                                else
                                {
                                    <p>
                                        <a asp-action="Edit" asp-route-id="@calendarEvent.CalendarEventID">Edit Event<span class="visually-hidden"> on @eventContext</span></a> |
                                        <a asp-action="Delete" onclick="confirmEventDeletion();" asp-route-id="@calendarEvent.CalendarEventID">Delete Event<span class="visually-hidden"> on @eventContext</span></a>
                                    </p>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts{
    <script>
        function confirmEventDeletion(message) {
            let userConfirmed = confirm(message || "Are you sure you want to delete this event?");
            if (!userConfirmed) {
                event.preventDefault();
            }
        }
    </script>
}