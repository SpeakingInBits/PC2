@model IEnumerable<PC2.Models.ViewModels.PersonViewModel>
@using PC2.Models

@{
    var selectedType = (PersonType?)ViewData["SelectedType"];
    var searchTerm = (string?)ViewData["SearchTerm"];
    ViewData["Title"] = "View Members";
}

<h1>@ViewData["Title"]</h1>

<div class="card mb-4">
    <div class="card-header">
        <h2 class="h5 mb-0">Search and Filter Members</h2>
    </div>
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-6">
                <label for="searchTerm" class="form-label">Search by Name</label>
                <input type="text" 
                       class="form-control" 
                       id="searchTerm" 
                       name="searchTerm" 
                       placeholder="Enter member name..." 
                       value="@searchTerm" />
            </div>

            <div class="col-md-6">
                <label for="type" class="form-label">Member Type</label>
                <select class="form-control" id="type" name="type">
                    <option value="">-- All Types --</option>
                    <option value="@nameof(PersonType.Staff)" selected="@(selectedType == PersonType.Staff)">Staff</option>
                    <option value="@nameof(PersonType.Board)" selected="@(selectedType == PersonType.Board)">Board</option>
                    <option value="@nameof(PersonType.SteeringCommittee)" selected="@(selectedType == PersonType.SteeringCommittee)">Steering Committee</option>
                </select>
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-primary">Search</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">Clear Filters</a>
            </div>
        </form>
    </div>
</div>

<p>
    <a asp-action="Create" class="btn btn-success">Add New Member</a>
</p>

@if (Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th scope="col"><span class="visually-hidden">Photo</span></th>
                <th scope="col">Name</th>
                <th scope="col">Title</th>
                <th scope="col">Type</th>
                <th scope="col">Details</th>
                <th scope="col"><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(item.CurrentImageUrl))
                        {
                            <img src="@item.CurrentImageUrl" alt=""
                                 style="width: 48px; height: 48px; object-fit: cover; border-radius: 4px;" />
                        }
                        else
                        {
                            <span class="text-muted" style="font-size: 2rem; line-height: 1;">
                                <i class="bi bi-person-circle" aria-hidden="true"></i>
                            </span>
                        }
                    </td>
                    <td>@item.Name</td>
                    <td>@item.Title</td>
                    <td>
                        @switch(item.Type)
                        {
                            case PersonType.Staff:
                                <span class="badge bg-primary">Staff</span>
                                break;
                            case PersonType.Board:
                                <span class="badge bg-info text-dark">Board</span>
                                break;
                            case PersonType.SteeringCommittee:
                                <span class="badge bg-secondary text-dark">Steering Committee</span>
                                break;
                        }
                    </td>
                    <td>
                        @switch(item.Type)
                        {
                            case PersonType.Staff:
                                <small>
                                    @if (!string.IsNullOrEmpty(item.Phone))
                                    {
                                        <div>@item.Phone</div>
                                    }
                                    @if (item.Extension.HasValue)
                                    {
                                        <div>Ext. @item.Extension</div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.Email))
                                    {
                                        <div>@item.Email</div>
                                    }
                                </small>
                                break;
                            case PersonType.Board:
                                <small>
                                    @if (!string.IsNullOrEmpty(item.MembershipStart))
                                    {
                                        <div>Since @item.MembershipStart</div>
                                    }
                                </small>
                                break;
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.ID" asp-route-type="@item.Type.ToString()" class="btn btn-sm btn-warning">Edit<span class="visually-hidden"> @item.Name</span></a>
                        <a asp-action="Delete" asp-route-id="@item.ID" asp-route-type="@item.Type.ToString()" class="btn btn-sm btn-danger">Delete<span class="visually-hidden"> @item.Name</span></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        <p>No members found matching your search criteria.</p>
        <a asp-action="Index" class="btn btn-sm btn-primary">View All Members</a>
    </div>
}
