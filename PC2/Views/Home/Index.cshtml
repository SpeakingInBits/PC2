@{
    ViewData["Title"] = "Home Page";
}

@section Head
{
    <style>
    #content {
        color: rgb(20, 100, 47);
    }

    #photo-header {
        width: 976px;
        height: 238px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    #intro {
        margin-top: 3.2em;
        max-width: 52em;
        margin-left: auto;
        margin-right: auto;
        padding: 0 1em;
    }

    #intro p {
        margin-bottom: 1.2em;
    }

    @@media only screen and (max-width: 820px) {
        #photo-header {
            width: 372px !important;
            height: inherit;
        }

        #photo-0 {
            display: none;
        }
    }

    @@media only screen and (max-width: 1236px) {
        #photo-header {
            width: 663px;
        }

        #photo-2 {
            display: none;
        }
    }
    </style>
}


<div id="photo-header">
    <img id="photo-0" src="~/images/home/handPaintGirl1.jpg" alt="Smiling girl with vibrant paint on her hands, raised playfully in front of her" />
    <img id="photo-1" src="~/images/home/handPaintGirl2.jpg" alt="Excited girl displaying her paint-covered hands, with a blurred creative workspace in the background" />
    <img id="photo-2" src="~/images/home/handPaintGirl3.jpg" alt="Joyful girl holding up her colorful hands, expressing enthusiasm for arts and crafts" />
</div>

    <div class="divider"></div>
    <div id="intro">
        <p>
            <strong>Empowering People. Strengthening Families. Building Community.</strong><br />
            Every person deserves the opportunity to live a full, meaningful, and self-directed life.<br />
            Across <strong>Pierce County</strong>, we empower individuals with intellectual and developmental
            disabilities&mdash;and the families who support them&mdash;by providing them with the resources,
            education, connections, and advocacy needed to thrive. Whether you're seeking information,
            navigating services, planning for the future, or building greater independence, you don't
            have to do it alone.
        </p>
        <p>
            From birth through adulthood, we provide trusted guidance, comprehensive resource information,
            educational workshops, homeownership assistance, employment resources, and connections to
            services and supports throughout Pierce County. We also empower self-advocates and their
            families to engage with policymakers, advocate for meaningful change, and make their
            voices heard.
        </p>
        <p>
            More than a resource, we are a trusted community partner. We walk alongside individuals and
            families as they navigate life's opportunities and challenges, celebrate milestones,
            overcome barriers, and build brighter futures.
        </p>
        <p>
            Together, we are building a stronger, more inclusive Pierce County&mdash;where every
            individual with intellectual and developmental disabilities is valued, supported, and
            empowered to reach their fullest potential.
        </p>
    </div>