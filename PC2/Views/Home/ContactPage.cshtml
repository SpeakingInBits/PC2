@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Contact Us";
}

<br />
<h1>@ViewData["Title"]</h1>

<div class="divider"></div>

@if (ViewData["EmailSent"] is bool EmailSentSuccessful)
{
    @if (EmailSentSuccessful)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Your email was sent successfully!</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    else
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>We were not able to send your email at this time, please try again later!</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    } 
}

<div class="text-center my-4">
    <p>
        Looking for help for yourself, your family, or someone you work with?
        Fill out our Get Help form and our team will contact you.
    </p>
    <a asp-controller="GetHelp" asp-action="Index" class="btn btn-primary btn-lg">Get Help</a>
</div>

<div>
    <div class="row align-items-center justify-content-center">
        <div class="col-auto col-md-5">
            <h2 class="h6 fw-bold">PC2</h2>
            <p>3716 Pacific Avenue</p>
            <p>Suite A</p>
            <p>Tacoma, WA  98418</p>
        </div>
        <div class="col-auto col-md-5 spaced-links">
            <p><a href="mailto:info@pc2online.org">info@pc2online.org</a></p>
            <p><a href="tel:+12535640707">253.564.0707</a></p>
            <p><a href="tel:+18773354657">877.335.4657</a></p>
            <p>253.564.0702 (fax)</p>
        </div>

        <div class="divider"></div>
        <iframe title="Map to PC2 Office" aria-label="Map to PC2 Office" width="768" height="500" style="max-width: 100%;" id="gmap_canvas" src="https://maps.google.com/maps?q=3716%20Pacific%20Avenue%20%20Suite%20A%20%20Tacoma,%20WA%20%2098418&t=&z=15&ie=UTF8&iwloc=&output=embed" frameborder="0" scrolling="no" marginheight="0" marginwidth="0"></iframe>
    </div>
</div>
