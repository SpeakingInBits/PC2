@model IEnumerable<PC2.Models.HousingProgram>

@{
    ViewData["Title"] = "Housing Program Data";
}

<h1>Housing Program Data</h1>

@{
    string? message = TempData["Message"] as string;
    bool hasTempData = message != null;
    
    if(hasTempData)
    {
    bool isError = !message!.Contains("successfully", StringComparison.OrdinalIgnoreCase);
    <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="@(isError ? "alert" : "status")">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    }
}

<table id="data_table" class="table">
    <thead>
        <tr>
            <th scope="col">
                @Html.DisplayNameFor(model => model.HouseHoldSize)
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.MaximumIncome)
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.LastUpdated)
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) 
{
        <tr>
            <td>
                @item.HouseHoldSize
            </td>
            <td>
                <form method="post">
                    <input type="hidden" name="HouseHoldSize" value="@item.HouseHoldSize">
                    <label for="maximumIncome-@item.HouseHoldSize" class="visually-hidden">Maximum income for household of @item.HouseHoldSize</label>
                    $<input name="MaximumIncome" id="maximumIncome-@item.HouseHoldSize" value="@item.MaximumIncome" inputmode="decimal" />
                    <button type="submit" class="btn btn-primary">Update Entry<span class="visually-hidden"> for household of @item.HouseHoldSize</span></button>
                </form>
            </td>
            <td>
                @item.LastUpdated.ToShortDateString()
            </td>
        </tr>
}
    </tbody>
</table>
@if(hasTempData)
{
    <script>
            document.getElementById("data_table").scrollIntoView();
    </script>
}
