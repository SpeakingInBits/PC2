@model IEnumerable<PC2.Models.NewsletterFile>

@{
    ViewData["Title"] = "Upload Newsletter";
}

<h1>@ViewData["Title"]</h1>
@{
    string? message = TempData["Message"] as string;
    
    if(message != null)
    {
        bool isError = message.StartsWith("Error");
        <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="@(isError ? "alert" : "status")">
            @message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
}
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="UploadNewsletter" enctype="multipart/form-data" method="post">
            <div class="form-group">
                <label for="userFile" class="control-label">Newsletter file</label>
                <input type="file" name="userFile" id="userFile" accept=".pdf" onchange="checkFileSize()" aria-describedby="userFileHelp fileSizeError" />
                <small id="userFileHelp" class="form-text text-muted d-block">PDF files only. Maximum size: 50 MB.</small>
                <span id="fileSizeError" class="text-danger" role="alert"></span>
            </div>
            <br />
            <div class="form-group">
                <input id="uploadButton" type="submit" value="Upload" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<br />
<table class="table">
    <thead>
        <tr>
            <th scope="col">
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th scope="col"><span class="visually-hidden">Actions</span></th>
        </tr>
    </thead>
    <tbody>
        @for (int i = Model.Count() - 1; i >= 0; i--) // Loop backwards so newest newsletters appear first
        {
            <tr>
                <td>
                    <a href="@Model.ElementAt(i).Location" target="_blank">@Model.ElementAt(i).Name</a>
                </td>
                <td>
                    <a asp-action="DeleteNewsletter" asp-route-id="@Model.ElementAt(i).NewsletterId">Delete<span class="visually-hidden"> @Model.ElementAt(i).Name</span></a> |
                    <a asp-action="RenameNewsletter" asp-route-id="@Model.ElementAt(i).NewsletterId">Rename<span class="visually-hidden"> @Model.ElementAt(i).Name</span></a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        function checkFileSize() {
            var fileInput = document.getElementById('userFile');
            var fileSizeError = document.getElementById('fileSizeError');
            var uploadButton = document.getElementById('uploadButton');
            var maxSize = 50 * 1024 * 1024; // 50MB

            if (fileInput.files.length > 0) {
                var file = fileInput.files[0];
                if (file.size > maxSize) {
                    fileSizeError.textContent = "The file size exceeds the 50MB limit.";
                    uploadButton.disabled = true;
                } else {
                    fileSizeError.textContent = "";
                    uploadButton.disabled = false;
                }
            } else {
                fileSizeError.textContent = "";
                uploadButton.disabled = false;
            }
        }
    </script>
}