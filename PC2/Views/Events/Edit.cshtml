@model CalendarCreateEventViewModel

@{
    ViewData["Title"] = "Edit Event";
}

<h1>@ViewData["Title"]</h1>

<h4>Calendar Event</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="EventId" />

            <!-- BASIC EVENT FIELDS -->
            <div class="form-group">
                <label asp-for="DateOfEvent" class="control-label"></label>
                <input asp-for="DateOfEvent" class="form-control" type="date" />
                <span asp-validation-for="DateOfEvent" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="StartingTime" class="control-label"></label>
                <input asp-for="StartingTime" class="form-control" type="time" />
                <span asp-validation-for="StartingTime" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="EndingTime" class="control-label"></label>
                <input asp-for="EndingTime" class="form-control" type="time" />
                <span asp-validation-for="EndingTime" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <!-- EVENT TYPE -->
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsPc2Event" />
                    @Html.DisplayNameFor(model => model.IsPc2Event)
                </label>
            </div>

            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsCountyEvent" />
                    @Html.DisplayNameFor(model => model.IsCountyEvent)
                </label>
                <span asp-validation-for="IsCountyEvent" class="text-danger"></span>
            </div>

            <hr />
            <h4>Recurrence (Optional)</h4>

            <!-- FREQUENCY -->
            <div class="form-group">
                <label>Frequency</label>
                <select asp-for="Frequency" class="form-control">
                    <option value="">None (No Recurrence)</option>
                    <option value="DAILY">Daily</option>
                    <option value="WEEKLY">Weekly</option>
                    <option value="MONTHLY">Monthly</option>
                    <option value="YEARLY">Yearly</option>
                </select>
            </div>

            <!-- INTERVAL -->
            <div class="form-group">
                <label>Interval (Every X days/weeks/months)</label>
                <input asp-for="Interval" class="form-control" type="number" min="1" />
            </div>

            <!-- END TYPE -->
            <div class="form-group">
                <label>End Type</label>
                <select asp-for="EndType" class="form-control">
                    <option value="NEVER">Never</option>
                    <option value="COUNT">After X Occurrences</option>
                    <option value="UNTIL">Until Date</option>
                </select>
            </div>

            <!-- COUNT -->
            <div class="form-group">
                <label>Count (Only if EndType = COUNT)</label>
                <input asp-for="Count" class="form-control" type="number" min="1" />
            </div>

            <!-- UNTIL -->
            <div class="form-group">
                <label>Until Date (Only if EndType = UNTIL)</label>
                <input asp-for="Until" class="form-control" type="date" />
            </div>

            <!-- ORDINAL -->
            <div class="form-group">
                <label>Ordinal (1, 2, 3, 4, -1 for last)</label>
                <input asp-for="Ordinal" class="form-control" type="number" />
            </div>

            <!-- WEEKDAY -->
            <div class="form-group">
                <label>Weekday</label>
                <select asp-for="Weekday" class="form-control">
                    <option value="">None</option>
                    <option value="MO">Monday</option>
                    <option value="TU">Tuesday</option>
                    <option value="WE">Wednesday</option>
                    <option value="TH">Thursday</option>
                    <option value="FR">Friday</option>
                    <option value="SA">Saturday</option>
                    <option value="SU">Sunday</option>
                </select>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>

        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
