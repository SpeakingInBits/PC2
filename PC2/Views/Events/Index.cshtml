@{
    ViewData["Title"] = "Event Calendar";
}
<!-- Events banner -->
<div class="d-flex justify-content-center">
    <img src="~/images/events/events1.jpg" alt="" />
    <img src="~/images/events/events2.jpg" alt="" />
    <img src="~/images/events/events3.jpg" alt="" />
    <img src="~/images/events/events4.jpg" alt="" />
</div>

<br />
<h1>@ViewData["Title"]</h1>
<div class="divider"></div>
<br />

@section Head {
    <style>
        .img-flyer {
            max-width: 625px;
            max-height: 875px;
        }

        .pc2-event {
            background-color: #d1e7dd !important; /* Light green */
            color: #212529 !important;
        }

        .county-event {
            background-color: #f8d7da !important; /* Light red */
            color: #212529 !important;
        }

        .legend {
            margin-top: 20px;
        }

        .legend-item {
            display: flex;
            align-items: center;
            margin-bottom: 10px;
        }

        .legend-color {
            width: 20px;
            height: 20px;
            margin-right: 10px;
        }

        /* CSS to word break on multiple lines in the event modal dialog */
        #modalEventTitle {
            overflow-wrap: anywhere;
        }
    </style>
}

<br />

<!-- Modal popup -->
<div class="modal fade" id="eventModal" tabindex="-1" aria-labelledby="eventModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5 fw-bold" id="eventModalLabel">Event Details</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <h3 class="h5" id="modalEventTitle" style="font-weight: normal;"></h3>
                <p><strong>Start Time:</strong> <span id="modalEventDate"></span></p>
                <p><strong>End Time:</strong> <span id="modalEventEndTime"></span></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"
        integrity="sha384-B1OFx8Gy9GjPu8UbUyXbGQpzll9ubAUQ9agInFJ8NnD7nYG1u/CLR+Sqr5yifl4q"
        crossorigin="anonymous"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {

            const isMobile = window.innerWidth < 768;
            const eventModalEl = document.getElementById('eventModal');
            let eventModalOpener = null;

            // Return focus to the event that opened the modal once it closes
            eventModalEl.addEventListener('hidden.bs.modal', function() {
                if (eventModalOpener && document.body.contains(eventModalOpener)) {
                    eventModalOpener.focus();
                }
                eventModalOpener = null;
            });

            // The prev/next buttons are named by their title; hide their icon spans (role="img" with no name)
            function hideToolbarIcons() {
                document.querySelectorAll('#calendar .fc-toolbar .fc-icon').forEach(function(icon) {
                    icon.setAttribute('aria-hidden', 'true');
                });
            }

            // Builds an event's title element from its HTML
            function buildEventTitle(event, tagName) {
                const title = document.createElement(tagName);
                title.innerHTML = event.title;

                // Prevent inner link navigation so clicks bubble to eventClick and open the modal.
                // Keep them out of the tab order too, since the event itself is focusable.
                title.querySelectorAll('a').forEach(function(a) {
                    a.tabIndex = -1;
                    a.addEventListener('click', function(e) {
                        e.preventDefault();
                    });
                });

                // Event type is otherwise shown only by colour
                const typeText = document.createElement('span');
                typeText.className = 'visually-hidden';
                typeText.textContent = event.classNames.includes('pc2-event') ? ' (PC2 event)' : ' (County event)';
                title.appendChild(typeText);
                return title;
            }

            // Month view shows timed events that fit in one day as a dot and the rest as a bar
            function isDotEvent(arg) {
                const event = arg.event;
                if (event.allDay || !arg.isStart || !arg.isEnd) {
                    return false;
                }
                if (!event.end || event.end <= event.start) {
                    return true;
                }
                // The end is exclusive, so an event ending at midnight still fits in its start day
                const lastMoment = new Date(event.end.getTime() - 1);
                return lastMoment.toDateString() === event.start.toDateString();
            }

            var calendar = new FullCalendar.Calendar(document.getElementById('calendar'), {
                initialView: 'listMonth',
                headerToolbar: isMobile ? {
                    left: 'prev,next',
                    center: 'title',
                    right: 'listMonth,dayGridMonth'
                } : {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'listMonth,dayGridMonth'
                },
                buttonText: {
                    today:  'Today',
                    month:  'Month',
                    list:   'List'
                },
                // Events can be reached with Tab and opened with Enter or Space
                eventInteractive: true,
                datesSet: function() {
                    // Runs after the toolbar re-renders
                    setTimeout(hideToolbarIcons, 0);
                },
                events: function(info, successCallback, failureCallback) {
                    // Only the dates the calendar is showing (yyyy-mm-dd; end is exclusive)
                    const range = new URLSearchParams({ start: info.startStr.slice(0, 10), end: info.endStr.slice(0, 10) });
                    fetch('@Url.Action("GetEvents", "Events")?' + range)
                        .then(function(response) {
                            return response.json();
                        })
                        .then(function(events) {
                            // Add color differentiation
                            events.forEach(event => {
                                event.classNames = [event.isPC2Event ? 'pc2-event' : 'county-event'];
                            });
                            successCallback(events);
                        })
                        .catch(function(error) {
                            console.error('Error fetching events:', error);
                            failureCallback(error);
                        });
                },
                eventClick: function(info) {
                    var startTime = info.event.start.toLocaleString();
                    var endTime = info.event.end ? info.event.end.toLocaleString() : 'N/A';

                    document.getElementById('modalEventTitle').innerHTML = info.event.title;
                    document.getElementById('modalEventDate').innerText = startTime;
                    document.getElementById('modalEventEndTime').innerText = endTime;

                    // Only an event opened with the keyboard has focus (FullCalendar stops a mouse click from
                    // focusing it). Otherwise focus is elsewhere, e.g. on a toolbar button, and returning it
                    // there would scroll the page away from the calendar.
                    eventModalOpener = info.el.contains(document.activeElement) ? document.activeElement : null;
                    bootstrap.Modal.getOrCreateInstance(eventModalEl).show();
                },
                validRange: function(currentDate) {
                    // Today's date
                    const start = new Date(currentDate);

                    // Sets end to 1 year in future based on today's date
                    const end = new Date(currentDate);
                    end.setMonth(end.getMonth() + 12);

                    return { start, end };
                },
                // Render HTML in event titles instead of escaped text. This goes through eventContent
                // rather than editing the DOM in eventDidMount, because FullCalendar re-renders events
                // (e.g. when the current view's button is clicked again) and would restore its own text.
                eventContent: function(arg) {
                    if (arg.view.type === 'listMonth') {
                        // This replaces FullCalendar's keyboard-focusable <a> (links in the title can't nest
                        // inside it), so use a focusable wrapper whose Enter/Space click bubbles to eventClick
                        // like a mouse click
                        const title = buildEventTitle(arg.event, 'span');
                        title.tabIndex = 0;
                        title.addEventListener('keydown', function(e) {
                            if (e.key === 'Enter' || e.key === ' ') {
                                e.preventDefault();
                                title.click();
                            }
                        });
                        return { domNodes: [title] };
                    }

                    // Month view: the same layout as FullCalendar's default content
                    const title = buildEventTitle(arg.event, 'div');
                    title.className = 'fc-event-title';
                    const time = document.createElement('div');
                    time.className = 'fc-event-time';
                    time.textContent = arg.timeText;

                    if (isDotEvent(arg)) {
                        const dot = document.createElement('div');
                        dot.className = 'fc-daygrid-event-dot';
                        dot.style.borderColor = arg.borderColor || arg.backgroundColor;
                        return { domNodes: arg.timeText ? [dot, time, title] : [dot, title] };
                    }

                    title.classList.add('fc-sticky');
                    const titleContainer = document.createElement('div');
                    titleContainer.className = 'fc-event-title-container';
                    titleContainer.appendChild(title);
                    const frame = document.createElement('div');
                    frame.className = 'fc-event-main-frame';
                    if (arg.timeText) {
                        frame.appendChild(time);
                    }
                    frame.appendChild(titleContainer);
                    return { domNodes: [frame] };
                },
                eventDidMount: function(info) {
                    // Add a Bootstrap tooltip on month view events so the full text is visible on hover
                    if (info.view.type === 'dayGridMonth') {
                        const tempDiv = document.createElement('div');
                        tempDiv.innerHTML = info.event.title;
                        const plainText = tempDiv.textContent || tempDiv.innerText || '';
                        new bootstrap.Tooltip(info.el, {
                            title: plainText,
                            placement: 'top',
                            trigger: 'hover focus',
                            container: 'body'
                        });
                    }
                },
                noEventsText: 'No events this month'
            });

            calendar.render();
            hideToolbarIcons();
        });
    </script>
}
<div class="row">
    <div class="col-12">
        <div id="calendar"></div>
    </div>
</div>
<div class="legend">
    <div class="legend-item">
        <div class="legend-color pc2-event"></div>
        <span>PC2 Event</span>
    </div>
    <div class="legend-item">
        <div class="legend-color county-event"></div>
        <span>County Event</span>
    </div>
</div>
