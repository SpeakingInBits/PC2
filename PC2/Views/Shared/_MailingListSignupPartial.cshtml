@using Microsoft.Extensions.Options
@using PC2.Services
@inject IOptions<SenderNetOptions> SenderNetOptions
@{
    var options = SenderNetOptions.Value;
}

@* Sender.net replaces the div with the mailing list sign-up form designed in the Sender.net dashboard.
   The form's fields, wording, and colors are edited there, not here. Needs _SenderNetScriptPartial from _Layout. *@
<section class="mailing-list-signup" aria-label="Join our mailing list">
    @if (options.IsConfigured)
    {
        <div style="text-align: left" class="sender-form-field" data-sender-form-id="@options.SignupFormId"></div>
    }
    else
    {
        @* Sender.net isn't configured (e.g. in development), so nothing can reach the real mailing list *@
        <p class="mailing-list-signup-placeholder">Mailing list sign-up appears here.</p>
    }
</section>
