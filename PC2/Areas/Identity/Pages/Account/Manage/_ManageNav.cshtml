@inject SignInManager<IdentityUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}
<ul class="nav flex-column nav-fill">
    <li class="nav-item menu-item"><a class="nav-link @ManageNavPages.IndexNavClass(ViewContext)" aria-current="@ManageNavPages.PageAriaCurrent(ViewContext, ManageNavPages.Index)" id="profile" asp-page="./Index">Profile</a></li>
    <li class="nav-item menu-item"><a class="nav-link @ManageNavPages.EmailNavClass(ViewContext)" aria-current="@ManageNavPages.PageAriaCurrent(ViewContext, ManageNavPages.Email)" id="email" asp-page="./Email">Email</a></li>
    <li class="nav-item menu-item"><a class="nav-link @ManageNavPages.ChangePasswordNavClass(ViewContext)" aria-current="@ManageNavPages.PageAriaCurrent(ViewContext, ManageNavPages.ChangePassword)" id="change-password" asp-page="./ChangePassword">Password</a></li>
    @if (hasExternalLogins)
    {
        <li id="external-logins" class="nav-item menu-item"><a id="external-login" class="nav-link @ManageNavPages.ExternalLoginsNavClass(ViewContext)" aria-current="@ManageNavPages.PageAriaCurrent(ViewContext, ManageNavPages.ExternalLogins)" asp-page="./ExternalLogins">External logins</a></li>
    }
    <li class="nav-item menu-item"><a class="nav-link @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)" aria-current="@ManageNavPages.PageAriaCurrent(ViewContext, ManageNavPages.TwoFactorAuthentication)" id="two-factor" asp-page="./TwoFactorAuthentication">Two-factor authentication</a></li>
    @* We don't want the client to accidentally delete the admin account *@
    @*<li class="nav-item menu-item"><a class="nav-link @ManageNavPages.PersonalDataNavClass(ViewContext)" id="personal-data" asp-page="./PersonalData">Personal data</a></li>*@
</ul>
